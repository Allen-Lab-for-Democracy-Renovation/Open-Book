# Your Postgres connection string. See "4. A Postgres database" in the README
# for where to get one.
DATABASE_URL="postgresql://user:password@host:5432/openbook?sslmode=require"

# Optional. Only if your provider gave you a separate "direct" (non-pooled)
# connection string — it is used for database migrations. Remove the leading #
# to enable it. Leave it commented out if you only have one connection string.
# DIRECT_URL="postgresql://user:password@host:5432/openbook?sslmode=require"
